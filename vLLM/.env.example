# =============================================================================
# vLLM — локальный OpenAI-совместимый LLM-сервер
# Скопируйте этот файл в .env и настройте под своё железо.
# Никогда не коммитьте .env в репозиторий.
# =============================================================================

# ---------------------------------------------------------------------------
# Модель
# ---------------------------------------------------------------------------
# Идентификатор модели на HuggingFace Hub.
# Рекомендованные модели для русского языка:
#   Qwen/Qwen2.5-1.5B-Instruct  — сверхлёгкая (~3 ГБ), базовая поддержка RU
#   Qwen/Qwen2.5-7B-Instruct    — хороший русский, ~14 ГБ VRAM
#   Qwen/Qwen2.5-14B-Instruct   — отличный русский, ~28 ГБ VRAM
#   Qwen/Qwen2.5-32B-Instruct   — лучший русский, ~64 ГБ VRAM
#   meta-llama/Llama-3.1-8B-Instruct — английский + мультиязычный, ~16 ГБ
#   google/gemma-3-4b-it        — сверхлёгкая, мультиязычная, ~8 ГБ
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Ревизия модели (ветка, тег или коммит). Оставьте пустым для основной.
VLLM_REVISION=
# Режим токенизатора: auto / slow / mistral
VLLM_TOKENIZER_MODE=auto

# ---------------------------------------------------------------------------
# Сервер
# ---------------------------------------------------------------------------
# Адрес, на котором vLLM слушает запросы
VLLM_HOST=0.0.0.0
# Порт vLLM API
VLLM_PORT=8100
# Имя Docker-контейнера
VLLM_CONTAINER_NAME=vllm-findoctor

# ---------------------------------------------------------------------------
# Аппаратное ускорение
# ---------------------------------------------------------------------------
# Автоопределение при сборке: Linux+NVIDIA → cuda, Linux+AMD → rocm,
#   macOS → cpu, Linux без GPU → cpu.
# Принудительно задать: cuda, rocm, cpu
VLLM_ACCELERATION=
# Количество GPU для tensor parallelism (только CUDA/ROCm)
VLLM_TENSOR_PARALLEL=1
# Доля VRAM под KV-кэш (0.0–1.0). 0.9 = 90% памяти GPU.
# Уменьшите если GPU используется другими процессами.
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Максимальная длина контекста модели. auto — использовать длину из конфига модели.
# Задайте число, чтобы ограничить (экономит VRAM).
VLLM_MAX_MODEL_LEN=

# ---------------------------------------------------------------------------
# Производительность
# ---------------------------------------------------------------------------
# Максимальное число одновременно обрабатываемых последовательностей.
# Больше → выше throughput, но больше памяти. По умолчанию 256.
VLLM_MAX_NUM_SEQS=256
# Максимальное число токенов в батче. auto — определяется автоматом.
VLLM_MAX_NUM_BATCHED_TOKENS=
# Количество потоков CPU (для CPU-режима и вспомогательных операций).
# По умолчанию — все доступные ядра.
VLLM_CPU_THREADS=

# ---------------------------------------------------------------------------
# Кэширование моделей
# ---------------------------------------------------------------------------
# Директория на хосте для хранения скачанных моделей.
# Модели кэшируются между перезапусками контейнера.
VLLM_MODELS_DIR=./models
# HuggingFace-кэш внутри контейнера (не меняйте без необходимости)
VLLM_HF_HOME=/root/.cache/huggingface

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------
# Уровень логирования: debug / info / warning / error
VLLM_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Docker-образ (автоматически подбирается под железо, но можно переопределить)
# ---------------------------------------------------------------------------
# CUDA:  vllm/vllm-openai:latest
# ROCm:  rocm/vllm:latest
# CPU:   vllm/vllm-openai:latest-cpu
VLLM_IMAGE=
# Платформа Docker-образа (linux/amd64). Для Apple Silicon Docker сам подставит.
VLLM_PLATFORM=

# ---------------------------------------------------------------------------
# Тестирование и бенчмаркинг
# ---------------------------------------------------------------------------
# Количество итераций для бенчмарка
VLLM_BENCH_ITERATIONS=5
# Количество параллельных запросов в тесте конкурентности
VLLM_BENCH_CONCURRENCY=2
