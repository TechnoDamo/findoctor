# =============================================================================
# FinDoctor Backend — переменные окружения
# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env в репозиторий.
# =============================================================================

# ---------------------------------------------------------------------------
# Окружение приложения
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# База данных PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=findoctor
POSTGRES_USER=findoctor
POSTGRES_PASSWORD=change_me
# Если DATABASE_URL не задан, он собирается из POSTGRES_* полей выше
DATABASE_URL=postgresql+psycopg://findoctor:change_me@localhost:5433/findoctor

# ---------------------------------------------------------------------------
# JWT-аутентификация
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_in_production_to_a_random_64char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Хеширование паролей (bcrypt)
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# AI-провайдеры (OpenAI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_AUDIO_MODEL=gpt-4o-audio-preview

# ---------------------------------------------------------------------------
# AI Chat: separate OpenAI-compatible endpoints for LLM / STT / TTS
# If *_API_KEY or *_BASE_URL is empty, OPENAI_API_KEY / OPENAI_BASE_URL are used.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=google/gemini-2.5-flash

STT_API_KEY=
STT_BASE_URL=https://routerai.ru/api/v1
STT_MODEL=google/gemini-2.5-flash

TTS_API_KEY=
TTS_BASE_URL=https://routerai.ru/api/v1
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=echo

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
GRAYLOG_ENABLED=true
GRAYLOG_REQUIRED=false
GRAYLOG_PROTOCOL=tcp
GRAYLOG_HOST=localhost
GRAYLOG_PORT=5556
GRAYLOG_FACILITY=findoctor-backend
LOG_HTTP_HEADERS=true
LOG_HTTP_BODIES=true
LOG_RESPONSE_HEADERS=true
LOG_RESPONSE_BODIES=true
LOG_DB_WRITES=true
