# =============================================================================
# whisper-server — OpenAI-совместимый сервер распознавания речи
# Скопируйте этот файл в .env и заполните реальными значениями.
# Никогда не коммитьте .env в репозиторий.
# =============================================================================

# ---------------------------------------------------------------------------
# Модель
# ---------------------------------------------------------------------------
# Имя модели для скачивания.
# Доступные: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en,
#            large-v1, large-v2, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# Директория с файлами моделей (по умолчанию — внутри whisper.cpp)
WHISPER_MODELS_DIR=./whisper.cpp/models

# ---------------------------------------------------------------------------
# Сервер
# ---------------------------------------------------------------------------
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080
# Внутренний порт whisper.cpp (прокси управляет им, наружу не торчит)
WHISPER_CPP_PORT=8082

# ---------------------------------------------------------------------------
# Производительность
# ---------------------------------------------------------------------------
WHISPER_THREADS=4
WHISPER_PROCESSORS=1

# ---------------------------------------------------------------------------
# Параметры распознавания
# ---------------------------------------------------------------------------
WHISPER_LANGUAGE=auto
WHISPER_MAX_CONTEXT=-1
WHISPER_MAX_LEN=0
WHISPER_BEST_OF=5
WHISPER_BEAM_SIZE=-1

# ---------------------------------------------------------------------------
# Дополнительные настройки (true / false)
# ---------------------------------------------------------------------------
WHISPER_NO_TIMESTAMPS=false
WHISPER_SPLIT_ON_WORD=false
WHISPER_DEBUG_MODE=false
WHISPER_CONVERT=false
WHISPER_NO_GPU=false
WHISPER_FLASH_ATTN=true
WHISPER_NO_CONTEXT=false
WHISPER_SUPPRESS_NST=false

# ---------------------------------------------------------------------------
# Порог тишины / не-речи
# ---------------------------------------------------------------------------
WHISPER_NO_SPEECH_THOLD=0.6

# ---------------------------------------------------------------------------
# Начальный промпт (опционально, только для английских моделей)
# ---------------------------------------------------------------------------
WHISPER_PROMPT=

# ---------------------------------------------------------------------------
# OpenAI-совместимые пути
# ---------------------------------------------------------------------------
# По умолчанию эндпоинт:  POST /inference
# Чтобы эндпоинт был /v1/audio/transcriptions, задайте:
#   WHISPER_REQUEST_PATH=/v1
#   WHISPER_INFERENCE_PATH=/audio/transcriptions
WHISPER_REQUEST_PATH=
WHISPER_INFERENCE_PATH=

# ---------------------------------------------------------------------------
# Аппаратное ускорение
# ---------------------------------------------------------------------------
# Автоопределение (Mac: CoreML + Metal, Linux: CUDA > ROCm > OpenBLAS).
# Принудительно задать: coreml, cuda, metal, opencl, vulkan, openblas, hipblas, none
WHISPER_ACCELERATION=
