# =============================================================================
# RAGFlow — конфигурация внутреннего RAG-сервиса ФинДоктора
# Скопируйте в .env: make init
# =============================================================================

# -- RAGFlow (upstream) ------------------------------------------------
RAGFLOW_REPO_URL=https://github.com/infiniflow/ragflow.git
RAGFLOW_RUNTIME_DIR=.runtime/ragflow
RAGFLOW_GIT_REF=main
RAGFLOW_BASE_URL=http://localhost:9380

# -- Service account FinDoctor backend --------------------------------
# Создайте API-ключ и датасет через RAGFlow UI (http://localhost:9380)
# и заполните эти поля. Backend использует их для вызова retrieval API.
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_DATASET_NAME=findoctor-recommendations

# -- Admin credentials (для make key-* и make ds-*) -------------------
# Email и пароль администратора RAGFlow. Используются для управления
# API-ключами и датасетами через curl.
RAGFLOW_ADMIN_EMAIL=
RAGFLOW_ADMIN_PASSWORD=

# -- Embedding provider ------------------------------------------------
# tei    — self-hosted HuggingFace TEI (бесплатно, CPU/GPU, BAAI/bge-m3)
#   Требуется: запущенный TEI (../tei/). Эндпоинт: /v1/embeddings
# openai — OpenAI-совместимый /v1/embeddings (облачный провайдер или RouterAI)
RAGFLOW_EMBEDDING_PROVIDER=tei

# === TEI (self-hosted) ===
TEI_BASE_URL=http://localhost:8200
TEI_MODEL_ID=BAAI/bge-m3
TEI_API_KEY=local-dev-key

# === OpenAI-совместимые эмбеддинги ===
# EMBEDDING_BASE_URL=https://routerai.ru/api/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# -- LLM provider (внутренний чат RAGFlow) ----------------------------
# vllm   — self-hosted vLLM сервер (бесплатно, GPU/CPU)
#   Требуется: запущенный vLLM (../vLLM/). Эндпоинт: /v1/chat/completions
# openai — OpenAI-совместимый /v1/chat/completions (облачный провайдер или RouterAI)
RAGFLOW_LLM_PROVIDER=vllm

# === vLLM (self-hosted) ===
VLLM_BASE_URL=http://localhost:8100/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# === OpenAI-совместимая LLM ===
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash
