# FinDoctor internal Hugging Face Text Embeddings Inference config.

TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_CONTAINER_NAME=tei-findoctor
TEI_HOST=0.0.0.0
TEI_PORT=8200
TEI_BASE_URL=http://localhost:8200

# Good multilingual default for Russian/English finance text.
# For lighter CPU usage, try intfloat/multilingual-e5-small.
TEI_MODEL_ID=BAAI/bge-m3
TEI_REVISION=

TEI_MODELS_DIR=./models
TEI_MAX_CLIENT_BATCH_SIZE=32
TEI_MAX_BATCH_TOKENS=16384
TEI_POOLING=

TEI_TEST_INPUT=FinDoctor-checks-cash-flow-debts-goals-and-emergency-reserves-before-recommendations.
