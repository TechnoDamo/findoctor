# FinDoctor internal SearXNG search service config.

SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_CONTAINER_NAME=searxng-findoctor
SEARXNG_HOST=0.0.0.0
SEARXNG_PORT=8201
SEARXNG_BASE_URL=http://localhost:8201

# Generate a new value with: openssl rand -hex 32
SEARXNG_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Keep this low for agent/tool usage. Increase only if backend needs more.
SEARXNG_REQUEST_TIMEOUT=10

SEARXNG_TEST_QUERY=site:cbr.ru
